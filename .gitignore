## Project-level .gitignore

# Node
node_modules/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files
.env
.env.*

# Dependency directories
/.pnp/
.pnp.js

# Coverage
coverage/
.nyc_output/

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
out/

# Test artifacts
playwright-report/
test-results/

# Caches
.cache/
.cache-loader/
